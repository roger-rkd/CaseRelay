              },
              "type": "ParseJson",
              "inputs": {
                "content": "@first(body('Classify_enquiry')?['choices'])?['message']?['content']",
                "schema": {
                  "type": "object",
                  "properties": {
                    "legal_matter": {
                      "type": "boolean"
                    },
                    "category": {
                      "type": "string"
                    },
                    "alternative_category": {
                      "type": "string"
                    },
