                  "item/cr_confidence": "@body('Parse_JSON')?['confidence']",
                  "item/cr_contextsufficient": "@body('Parse_JSON')?['context_sufficient']",
                  "item/cr_escalated": "@not(and(empty(outputs('Rule_Check')),equals(body('Parse_JSON')?['legal_matter'],true),equals(body('Parse_JSON')?['ambiguous'],false),equals(body('Parse_JSON')?['context_sufficient'],true),greaterOrEquals(body('Parse_JSON')?['confidence'],parameters('Confidence Threshold (cr_ConfidenceThreshold)')),contains(createArray('None','Other'),coalesce(body('Parse_JSON')?['alternative_category'],'x'))))",
                  "item/cr_legalmatter": "@body('Parse_JSON')?['legal_matter']",
                  "item/cr_model": "@outputs('Classify_enquiry')?['body/model']",
                  "item/cr_predictedcategory": "@coalesce(json('{\"Commercial\":121590000,\"Employment\":121590001,\"Property\":121590002,\"Dispute\":121590003,\"Other\":121590004}')?[body('Parse_JSON')?['category']], 121590004)",
                  "item/cr_promptversion": "v3",
                  "item/cr_rawresponse": "@first(body('Classify_enquiry')?['choices'])?['message']?['content']",
                  "item/cr_ruletriggered": "@outputs('Rule_Check')",
                  "item/cr_runtype": 121590000,
                  "item/cr_thresholdapplied": "@string(parameters('Confidence Threshold (cr_ConfidenceThreshold)'))"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "connectionName": "shared_commondataserviceforapps"
                }
