                      "item/cr_casestatus": 121590002,
                      "item/cr_category": "@coalesce(json('{\"Commercial\":121590000,\"Employment\":121590001,\"Property\":121590002,\"Dispute\":121590003,\"Other\":121590004}')?[body('Parse_JSON')?['category']], 121590004)",
                      "item/cr_confidence": "@body('Parse_JSON')?['confidence']",
                      "item/cr_contextsufficient": "@body('Parse_JSON')?['context_sufficient']"
                    },
