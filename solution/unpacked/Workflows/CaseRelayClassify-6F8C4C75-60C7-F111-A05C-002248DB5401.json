                        "item/cr_escalationreason": "@if(not(empty(outputs('Rule_Check'))),121590002,if(equals(body('Parse_JSON')?['legal_matter'],false),121590005,if(less(body('Parse_JSON')?['confidence'],parameters('Confidence Threshold (cr_ConfidenceThreshold)')),121590000,if(equals(body('Parse_JSON')?['context_sufficient'],false),121590001,121590006))))"
